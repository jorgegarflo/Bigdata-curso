<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Configuracion de YARN (ResourceManager / NodeManager).
-->
<configuration>

  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>yarnmaster</value>
  </property>

  <!--
    Sin esta propiedad, la webapp del RM se enlaza unicamente a la IP que
    resuelve "yarnmaster" y el healthcheck por localhost responde 000.
    Se escucha en todas las interfaces manteniendo "yarnmaster" como direccion
    anunciada a los NodeManagers.
  -->
  <property>
    <name>yarn.resourcemanager.bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services.mapreduce.shuffle.class</name>
    <value>org.apache.hadoop.mapred.ShuffleHandler</value>
  </property>

  <property>
    <name>yarn.nodemanager.local-dirs</name>
    <value>/hadoop/yarn/local</value>
  </property>
  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>/hadoop/yarn/log</value>
  </property>

  <!-- Recursos por NodeManager.  2048 MB es suficiente para los trabajos de
       practicas (WordCount, Pig, mrjob, Hive) y deja al contenedor DataNode+
       NodeManager (mem_limit: 3g) 1 GB de margen para las 2 JVM + tareas.
       Al escalar a 2-3 DataNodes la capacidad total del cluster se multiplica. -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>2048</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>2</value>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>512</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>2048</value>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-vcores</name>
    <value>1</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-vcores</name>
    <value>2</value>
  </property>

  <!-- Variables que YARN propaga a los contenedores (imprescindible en Java 17) -->
  <property>
    <name>yarn.nodemanager.env-whitelist</name>
    <value>JAVA_HOME,HADOOP_COMMON_HOME,HADOOP_HDFS_HOME,HADOOP_CONF_DIR,CLASSPATH_PREPEND_DISTCACHE,HADOOP_YARN_HOME,HADOOP_HOME,PATH,LANG,TZ,HADOOP_MAPRED_HOME</value>
  </property>

  <!-- Agregacion de logs y JobHistory Server -->
  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.nodemanager.remote-app-log-dir</name>
    <value>/yarn</value>
  </property>
  <property>
    <name>yarn.nodemanager.remote-app-log-dir-suffix</name>
    <value>logs</value>
  </property>
  <property>
    <name>yarn.log.server.url</name>
    <value>http://yarnmaster:19888/jobhistory/logs</value>
  </property>
  <property>
    <name>yarn.nodemanager.delete.debug-delay-sec</name>
    <value>0</value>
  </property>

  <property>
    <name>yarn.resourcemanager.scheduler.class</name>
    <value>org.apache.hadoop.yarn.server.resourcemanager.scheduler.capacity.CapacityScheduler</value>
  </property>

  <!--
    ProxyServer de YARN (redireccion de las UIs de las aplicaciones).
    En Hadoop 3.5 "yarn.web-proxy.address" NO tiene valor por defecto: si se
    deja vacio, el arranque del proxy standalone termina con error -1.  Se fija
    explicitamente un puerto (8089, distinto del RM en 8088) y el bind en todas
    las interfaces para que el proxy funcione dentro de la red de practicas.
  -->
  <property>
    <name>yarn.web-proxy.address</name>
    <value>yarnmaster:8089</value>
  </property>
  <property>
    <name>yarn.web-proxy.bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>

</configuration>
